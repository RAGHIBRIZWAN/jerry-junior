# Leave VITE_API_URL empty: the website uses its own /api and /media (Vercel functions).
# Only set it if you host the API somewhere else.
VITE_API_URL=

# Shop details shown on the site
VITE_BRAND_NAME=Jerrys Junior
VITE_TAGLINE=Stylish, comfortable clothing for little ones
VITE_CURRENCY=PKR
VITE_SHOP_CITY=Karachi, Pakistan

# The WhatsApp number is read from the backend (backend/.env VENDOR_WHATSAPP).
# This is only used if the backend is offline, so the WhatsApp button still works.
VITE_VENDOR_WHATSAPP=923340030844

# Messages in the scrolling top bar, separated by |
VITE_ANNOUNCEMENTS=Order easily on WhatsApp|No account needed|Kids clothing from Karachi

# Social links (leave empty to hide)
VITE_FACEBOOK_URL=https://www.facebook.com/people/Jerrys-Junior/61596077745640/
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=

# Your Vercel URL, used for share links (Open Graph)
VITE_SITE_URL=https://your-shop.vercel.app

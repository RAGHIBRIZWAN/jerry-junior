# ---- Database (MongoDB Atlas: products, orders, banners) ----
# Put the database name (jerry) right after .net/
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jerry?retryWrites=true&w=majority

# ---- Photos (Cloudinary free plan) ----
# Cloudinary dashboard > "Product Environment Credentials". Keep the API secret private:
# it belongs ONLY in this file on your laptop, never on Vercel.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ---- Servers (your laptop) ----
# Local preview API (the live website does not use this: it runs on Vercel)
PUBLIC_PORT=5000
# Admin panel + admin API. Always bound to 127.0.0.1. Never expose it.
ADMIN_PORT=5001

# ---- Admin login ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Shop details ----
SHOP_NAME=Jerrys Junior
SHOP_CITY=Karachi
CURRENCY=PKR
# International format, no + and no spaces, e.g. 923001234567
VENDOR_WHATSAPP=923001234567

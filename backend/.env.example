# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/jerry-junior

# ---- Servers ----
# Local preview API (the live website does not use this: it runs on Vercel)
PUBLIC_PORT=5000
# Admin panel + admin API. Always bound to 127.0.0.1. Never expose it.
ADMIN_PORT=5001

# ---- Admin login ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- URLs ----
# Optional. Not needed when the website and API are both on Vercel (same address).
FRONTEND_URL=https://your-shop.vercel.app


# ---- Shop details ----
SHOP_NAME=Jerrys Junior
SHOP_CITY=Karachi
CURRENCY=PKR
# International format, no + and no spaces, e.g. 923001234567
VENDOR_WHATSAPP=923001234567
